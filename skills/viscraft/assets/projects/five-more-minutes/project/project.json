        "id": "shot_0",
        "scene": "scene_0",
        "look": "watercolor",
        "intent": "田园远景，睡着的云与片名同框。鸟掠过，云呼吸。",
        "targetFrames": 120
      },
      {
        "id": "shot_1",
        "scene": "scene_1",
        "look": "watercolor",
        "intent": "闹钟响，云醒来，把今日下雨划成明天。",
        "targetFrames": 144
      },
      {
        "id": "shot_2",
        "scene": "scene_2",
        "look": "watercolor",
        "intent": "想象中的三只羊跳过云，云认真数数。",
        "targetFrames": 96
      },
      {
        "id": "shot_3",
        "scene": "scene_3",
        "look": "watercolor",
        "intent": "云伸手把彩虹系上蝴蝶结，忙碌而没有落雨。",
        "targetFrames": 96
      },
      {
        "id": "shot_4",
        "scene": "scene_4",
        "look": "watercolor",
        "intent": "云捧着拟人雨滴，因害怕而回缩。",
        "targetFrames": 144
      },
      {
        "id": "shot_5",
        "scene": "scene_5",
        "look": "watercolor",
        "intent": "低头看见捧空杯的垂首小花；小花只求一滴。",
        "targetFrames": 144
      },
      {
        "id": "shot_6",
        "scene": "scene_6",
        "look": "watercolor",
        "intent": "云的神情从担心变成温柔，将清单折成纸飞机放飞。",
        "targetFrames": 120
      },
      {
        "id": "shot_7",
        "scene": "scene_7",
        "look": "watercolor",
        "intent": "云吸气、变形，张开手，让雨滴离开。",
        "targetFrames": 96
      },
      {
        "id": "shot_8",
        "scene": "scene_8",
        "look": "watercolor",
        "intent": "微距跟随雨滴，落入花杯，细小飞溅与涟漪。",
        "targetFrames": 96
      },
      {
        "id": "shot_9",
        "scene": "scene_9",
        "look": "watercolor",
        "intent": "云欢快降雨，花朵抬头，蜗牛撑叶伞。",
        "targetFrames": 216
      },
      {
        "id": "shot_10",
        "scene": "scene_10",
        "look": "watercolor",
        "intent": "拉回温暖的彩虹田园；小云从打盹醒来，选择今天开始。",
        "targetFrames": 168
      }
