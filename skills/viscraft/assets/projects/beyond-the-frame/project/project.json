  "schemaVersion": 1,
  "id": "beyond-the-frame-reference",
  "revision": 1,
  "title": "框外的海 | Beyond the Frame",
  "direction": {
    "intent": "A single harbour world changes from drawn ink and paint into real limestone, plaster, feathers and water. Preserve village, tower, parapet, boats, mountain ridge and subject placement through the paper tear; reveal the adjoining cove through motivated camera travel.",
    "looks": [
      {
        "id": "comic",
        "description": "Bright hand-painted gouache comic; imperfect ink lines, warm paper, coral/turquoise/butter-yellow."
      },
      {
        "id": "coast",
        "description": "Photographic incarnation of the same illustrated harbour: retain limestone parapet, ochre paving, coral/yellow village and tower, sailboats, mountain ridge, teal bicycle and rider placement; then reveal its adjoining sheltered water through motivated camera travel."
      }
    ],
    "transitions": [
      {
        "from": "comic",
        "to": "coast",
        "intent": "A physical breakthrough in the comic border: torn paper transforms into golden light motes while the same rider and wheel motion continue into real coastal space."
      }
    ]
  },
